# ── Database (Neon Postgres via the Vercel Marketplace — free tier) ──────────
# Pooled URL used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signups"
# Direct (non-pooled) URL used by `prisma migrate`. The Neon integration sets this.
# DATABASE_URL_UNPOOLED=""

# Public base URL used in emailed links (no trailing slash).
APP_URL="http://localhost:3000"

# Comma-separated emails that can always sign in as admins (bootstrap the first organizer).
ADMIN_EMAILS="you@example.com"

# ── Email (Resend — free tier: 3,000 emails/month) ───────────────────────────
# Leave empty locally: emails are printed to the server console instead.
RESEND_API_KEY=""
# Must use a domain verified in Resend to email parents.
EMAIL_FROM="Rancho Solano PTO <signups@ranchosignup.com>"

# Random string; salts the hashed IPs used for rate limiting.
RATE_LIMIT_SALT="change-me"

# ── Photos (Vercel Blob — free on the Hobby plan) ────────────────────────────
# Set automatically when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=""
